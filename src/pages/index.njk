---
layout: layouts/base.njk
permalink: /
title: Karina Brown
description: Karina Brown takes vague ideas and makes them real – in big companies and early ventures.
---
<section class="hero bleed">
  <div class="hero__inner">
    <h1 class="hero__line">
      <span class="hero__line-a">Hi, I’m Karina<span class="stop stop--a">.</span></span>
      <span class="hero__line-b">I take vague ideas and make them real – in big companies and early ventures<span class="stop stop--b">.</span></span>
    </h1>
  </div>
  <a class="hero__scroll" href="#cards">
    <span class="visually-hidden">Scroll to sections</span>
    <svg class="hero__scroll-arrow" viewBox="0 0 16 28" aria-hidden="true" focusable="false">
      <path d="M8 0 V25 M1 18 L8 25 L15 18" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </a>
</section>

<section class="cards bleed" id="cards" aria-labelledby="cards-heading" data-reveal>
  <h2 class="visually-hidden" id="cards-heading">Sections</h2>
  <ul class="cards__grid">
    {% for card in cards %}
      <li>
        <a class="card card--{{ card.n }}" href="{{ card.url }}">
          <span class="card__inner">
            <span class="card__face card__face--front">
              <span class="card__title">{{ card.title }}</span>
              <span class="card__desc card__desc--static">{{ card.desc }}</span>
            </span>
            <span class="card__face card__face--back" aria-hidden="true">
              <span class="card__desc">{{ card.desc }}</span>
            </span>
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
