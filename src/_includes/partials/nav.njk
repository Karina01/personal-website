<nav class="nav" data-nav aria-label="Primary">
  <a class="nav__home" href="/" aria-label="{{ site.title }} — home">
    {% if logoSvg %}
      {{ logoSvg | safe }}
    {% else %}
      <span class="nav__home-text">{{ site.title }}</span>
    {% endif %}
  </a>

  <button
    class="nav__toggle"
    type="button"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="nav-links"
    aria-label="Open menu"
  >
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
    <span class="nav__toggle-bar"></span>
  </button>

  <ul class="nav__links" id="nav-links">
    {% for item in nav %}
      <li>
        <a
          class="nav__link"
          href="{{ item.url }}"
          {% if page.url == item.url %}aria-current="page"{% endif %}
        >{{ item.label }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
