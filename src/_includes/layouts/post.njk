---
layout: layouts/base.njk
---
{# Stubbed for newsletter posts. Not linked from anywhere yet. #}
<article>
  <div class="page-head bleed">
    <div class="page-head__inner">
      <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      <h1 class="page-head__title">{{ title }}</h1>
      {% if lead %}<p class="lead page-head__lead">{{ lead }}</p>{% endif %}
    </div>
  </div>
  <div class="row section" data-reveal>
    <div class="row__main prose">
      {{ content | safe }}
    </div>
  </div>
</article>
