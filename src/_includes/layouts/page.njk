---
layout: layouts/base.njk
---
<div class="row page-head">
  <div class="row__main">
    {% if label %}<p class="meta">{{ label }}</p>{% endif %}
    <h1 class="page-head__title">{{ title }}</h1>
    {% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
  </div>
</div>

<div class="row section" data-reveal>
  <div class="row__main prose">
    {% if photo.src %}
      <figure class="figure-break">
        <img
          src="{{ photo.src }}"
          {% if photo.srcset %}srcset="{{ photo.srcset }}" sizes="(max-width: 899px) 100vw, 400px"{% endif %}
          width="{{ photo.width }}"
          height="{{ photo.height }}"
          alt="{{ photo.alt }}"
          loading="lazy"
          decoding="async"
        />
        {% if photo.caption %}<figcaption class="caption">{{ photo.caption }}</figcaption>{% endif %}
      </figure>
    {% endif %}
    {{ content | safe }}
  </div>
</div>
